{
  "version": 1,
  "campaign": "madden64-full-pipeline",
  "timeout_seconds": 86400,
  "results": "build/research/desktop-farm/integration-results.jsonl",
  "lanes": [
    {
      "name": "inventory",
      "resource": "cpu",
      "cpus": 1,
      "gpu": 0,
      "command": ["python3", "tools/build_function_research_catalog.py"],
      "inputs": ["tools/build_function_research_catalog.py", "config/us/progress.toml"],
      "outputs": ["build/research/function_catalog.json"]
    },
    {
      "name": "compiler-attribution",
      "resource": "gpu",
      "cpus": 0,
      "gpu": 0.5,
      "command": ["n64-gpu", "python", "tools/gpu_compiler_attribution.py", "train", "build/research/compiler-corpus/raw.jsonl", "build/research/compiler-corpus/model.pt", "--epochs", "120", "--seed", "20261113"],
      "inputs": ["tools/compiler_corpus.py", "tools/gpu_compiler_attribution.py", "build/research/compiler-corpus/raw.jsonl", "build/research/compiler-corpus/blobs"],
      "outputs": ["build/research/compiler-corpus/model.pt"],
      "seeds": [20261113]
    },
    {
      "name": "residual-router",
      "resource": "cpu",
      "cpus": 2,
      "gpu": 0,
      "command": ["python3", "tools/residual_router.py", "train", "build/research/residual-router/examples.jsonl", "build/research/residual-router/model.json"],
      "inputs": ["tools/residual_router.py", "build/research/residual-router/examples.jsonl", "build/research/residual-router/blobs"],
      "outputs": ["build/research/residual-router/model.json"]
    },
    {
      "name": "context-retrieval",
      "resource": "gpu",
      "cpus": 0,
      "gpu": 0.5,
      "command": ["n64-gpu", "python", "tools/gpu_retrieval_ensemble.py", "--root", ".", "--catalog", "build/research/function_catalog.json", "--output", "build/research/context-donors.jsonl", "--iterations", "4096", "--neighbors", "32", "--seed", "20261113"],
      "inputs": ["tools/gpu_function_retrieval.py", "tools/gpu_retrieval_ensemble.py", "build/research/function_catalog.json"],
      "outputs": ["build/research/context-donors.jsonl"],
      "depends_on": ["inventory"],
      "seeds": [20261113]
    },
    {
      "name": "job-builder",
      "resource": "cpu",
      "cpus": 1,
      "gpu": 0,
      "command": ["python3", "tools/build_desktop_jobs.py", "build/research/context-donors.jsonl", "build/research/desktop-jobs.jsonl", "--root", ".", "--limit", "100", "--donors", "2", "--iterations", "3000", "--seeds", "20261113,20261114,20261115", "--lanes", "kmc+builtin,kmc+asn64,ido5.3,ido7.1,sn"],
      "inputs": ["tools/build_desktop_jobs.py", "build/research/context-donors.jsonl"],
      "outputs": ["build/research/desktop-jobs.jsonl"],
      "depends_on": ["context-retrieval"]
    },
    {
      "name": "permutation-farm",
      "resource": "cpu",
      "cpus": 30,
      "gpu": 0,
      "command": ["python3", "tools/desktop_permute_farm.py", "build/research/desktop-jobs.jsonl", "build/research/desktop-farm", "--root", ".", "--workers", "30", "--python", "python3", "--lane-timeout", "21600"],
      "inputs": ["tools/desktop_permute_farm.py", "build/research/desktop-jobs.jsonl"],
      "outputs": ["build/research/desktop-farm"],
      "environment": {"PYTHONPATH": "../n64-decomp-kit"},
      "depends_on": ["job-builder"],
      "seeds": [20261113, 20261114, 20261115]
    }
  ]
}
